  "sourceArchitecture": {
    "ui": "React/Vite PublisherPage.tsx (720 lines), isolated Publisher directory",
    "api": "Node serverless /api/publisher?action=...; maxDuration 300 seconds",
    "database": "Neon PostgreSQL through @neondatabase/serverless; DATABASE_URL",
    "media": "Vercel Blob private; no real media read or copied",
    "generation": "OpenAI text/image calls with original prompts, fallback/anti-repeat rules, image defaults medium/gpt-image-2 and text gpt-5.6-luna",
    "daily": "Explicit POST generate daily; GET today/status/history do not generate. No cron configured in checked-in vercel.json; no .github automation directory."
  },
  "sourceFeatureMapping": [
    {
      "source": "CreativeSelector, ChoiceGroup",
      "integration": "components/publisher/PublisherPage.tsx: same Univers/Moment/Style values/text/layout"
    },
    {
      "source": "generate daily/guided, polling status, persisted requestId",
      "integration": "Same API action names, CRM Bearer access, actor-qualified requestId recovery; no automatic regeneration on GET"
    },
    {
      "source": "PostEditor, GenerationProgress, HistoryGrid",
      "integration": "Same source components, captions/hashtags/music/dates/formats/layout; authenticated Blob previews"
    },
    {
      "source": "PostEditor selectedMusic useEffect dependencies",
      "integration": "Identity and persisted/primary music dependencies preserved; unrelated text regeneration cannot reset selection"
    },
    {
      "source": "prepareInstagramImage",
      "integration": "Same 1080x1350 Feed and 1080x1920 Reel still-image crop and JPEG .92; no video added"
    },
    {
      "source": "regenerate-text / regenerate-image",
      "integration": "Both server functions reused; image action now exposed by a permission-gated button (source UI had only text button)"
    },
    {
      "source": "publish -> markPublished",
      "integration": "Mark history only; explicit Marquer comme publié, CRM sensitive mark_published, no Meta publishing"
    },
    {
      "source": "shared password/cookie login",
      "integration": "Removed from integrated UI/API; CRM account session exclusively"
    },
    {
      "source": "copy / image download / music availability",
      "integration": "Source operations preserved; explicit export permission for export/copy commands and contribution for availability changes"
    },
    {
      "source": "body-level CSS",
      "integration": "Publisher root scope; no global body class, shared navigation supplied by AccessPortal"
    }
